{
  "name": "zxt-next",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm --workspace @zxt/admin run dev",
    "dev:api": "npm --workspace @zxt/api run dev",
    "start:local": "node scripts/start-local.mjs",
    "stop:local": "node scripts/stop-local.mjs",
    "start:mobile:https": "node scripts/start-mobile-https.mjs",
    "setup:mobile:https": "powershell -ExecutionPolicy Bypass -File scripts/setup-mobile-https.ps1",
    "build": "node scripts/build.mjs all",
    "build:api": "node scripts/build.mjs api",
    "build:admin": "node scripts/build.mjs admin",
    "build:mobile": "node scripts/build.mjs mobile",
    "smoke:p1:exam": "node scripts/smoke-p1-exam.mjs",
    "lint": "npm --workspaces --if-present run lint",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/database/prisma/schema.prisma",
    "db:seed": "node packages/database/prisma/seed.mjs",
    "db:sqlite:init": "node packages/database/sqlite/init.mjs",
    "setup": "npm run db:sqlite:init"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "sql.js": "^1.14.1",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2"
  }
}

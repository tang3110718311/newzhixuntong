# ===== 智训通 API 环境变量模板 =====
# 使用方式：复制本文件为 .env，然后按需修改
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env

# --- 数据库 ---
DATABASE_URL="file:../../../storage/dev.db"

# --- 默认租户 ---
DEFAULT_TENANT_CODE="zxt-demo"

# --- AI Provider（服务端配置）---
AI_PROVIDER_TYPE="llm"
AI_PROVIDER_NAME=""
AI_MODEL_NAME=""
AI_BASE_URL=""
AI_API_KEY=""

# 允许本地开发通过 x-tenant-code 请求头指定租户。
# 安全规则：即使这里设为 true，服务端也只接受 localhost/127.0.0.1 或 DEV_TENANT_HEADER_HOSTS 中的主机。
ALLOW_DEV_TENANT_HEADER=false
# DEV_TENANT_HEADER_HOSTS=10.0.0.10

# 跨域白名单，生产环境建议填写管理端正式域名；多个域名用英文逗号分隔。
# API_CORS_ORIGINS=https://www.example.com

# 图形验证码有效期和容差配置。
CAPTCHA_EXPIRES_IN=120
CAPTCHA_TOKEN_EXPIRES_IN=60
CAPTCHA_TOLERANCE=12
CAPTCHA_MAX_ATTEMPTS=5

# External model/speech request timeouts (milliseconds).
AI_PROVIDER_TIMEOUT_MS=45000
LLM_CHAT_TIMEOUT_MS=45000
LLM_AUX_TIMEOUT_MS=15000
LLM_SCORE_TIMEOUT_MS=40000
SCRIPT_CHECK_TIMEOUT_MS=30000
STT_TIMEOUT_MS=45000

# --- 语音服务（STT / TTS）---
# 说明：TTS 仅使用智训通自有服务（配置 ZXT_TTS_BASE_URL）；STT 使用 FunASR 桥接。

# 后端 STT 转写桥接（FunASR，wss）
FUNASR_BRIDGE_URL=wss://zxt.xingyiwulian.cn:8765

# 后端 TTS（旧版智训通 TTS 服务，OpenAI 兼容 /v1/audio/speech）
ZXT_TTS_BASE_URL=http://171.109.109.90:10030

# 本地备选：Whisper 转写服务（如本地已启动）
# WHISPER_BASE_URL=http://localhost:8178
